# Memo Arcana service configuration (non-secret defaults)
#
# For secrets (API keys, DB passwords) create /etc/memo/secrets.env.
# See /usr/share/doc/memo/secrets.env.example for expected keys.
#
# Restart memo-arcana.service after editing:
#   sudo systemctl restart memo-arcana

# Arcana bus connection
ARCANA_HOST=127.0.0.1
ARCANA_PORT=19118

# Namespace config file
MEMO_NAMESPACES=/etc/memo/namespaces.yaml

# Let bus clients register namespaces this config doesn't list (open action).
# Off by default: such a client picks the database the service opens.
#MEMO_BUS_OPEN=1
